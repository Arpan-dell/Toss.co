# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API. The NEXT_PUBLIC_ pair is safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key ("service_role"). Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string shared with the Apps Script bridge and the backfill script.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEVICE_BRIDGE_KEY=

# Vercel sends this as a Bearer token to the daily keep-alive cron.
CRON_SECRET=

# Price used for orders from baskets whose owner hasn't joined a business yet.
DEFAULT_PRICE_PER_KG=80

# "Log in with Telegram" (OpenID Connect). In the @BotFather mini app → your customer bot → Login Widget:
# add Allowed URLs (https://<app>.vercel.app and https://<app>.vercel.app/api/telegram/callback),
# then copy the Client Secret. The Client ID is the bot's numeric ID (the part of its token before ':').
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Driver dispatch (driver bot runs in the cloud via webhook).
# Create the bot with @BotFather, then:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" -d url=https://<app>/api/telegram/driver-webhook -d secret_token=<SECRET>
TELEGRAM_DRIVER_BOT_TOKEN=
TELEGRAM_DRIVER_BOT_USERNAME=
TELEGRAM_DRIVER_WEBHOOK_SECRET=
# Customer bot token, send-only (driver assigned / picked up). The basket keeps polling this bot.
TELEGRAM_CUSTOMER_BOT_TOKEN=
# Emails (business sign-ups, subscription payments, renewals, removal requests) from the Toss Gmail.
# Needs 2-Step Verification on, then Google Account → Security → App passwords. Leave empty to disable.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where owner alerts go (defaults to GMAIL_USER).
OWNER_EMAIL=

# Toss AI (Google Gemini, free tier). Google AI Studio → Get API key. Server-only. Leave empty to use the rules engine.
GEMINI_API_KEY=
# Optional first-choice model (falls back to gemini-3.5-flash-lite).
GEMINI_MODEL=

# Public URL of this deployment, used in emails, Telegram buttons and invoices.
SITE_URL=https://your-app.vercel.app

# ---- Only for the scripts in scripts/ (end-to-end tests, demo data). Not needed by the app. ----
# Deployed site the e2e scripts test against.
TOSS_SITE=https://your-app.vercel.app
# Same value as DEVICE_BRIDGE_KEY.
TOSS_BRIDGE_KEY=
# Ingest endpoint for scripts/demo-order.ts (defaults to $TOSS_SITE/api/ingest).
TOSS_INGEST_URL=
# Password given to the demo accounts created by scripts/demo-data.ts.
DEMO_PASSWORD=
# Server-action ID for scripts/e2e-password.ts (read from the built page).
CHANGE_PASSWORD_ACTION_ID=
